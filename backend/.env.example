# .env.example - Copy this file to .env and fill in your values

# Server Configuration
PORT=5000

# PostgreSQL Database Configuration
DB_USER=postgres                    # Your database username
DB_HOST=localhost                   # Database host (localhost for local development)
DB_NAME=industrial_maintenance      # Database name
DB_PASSWORD=your_secure_password    # Your database password
DB_PORT=5432                        # PostgreSQL default port